    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:app": "electron-vite build",
    "build:web": "vite build",
    "release:source": "node scripts/package-source.mjs",
    "build:media": "node scripts/build-media-toolchain.mjs",
    "build:media:win": "node scripts/build-media-toolchain.mjs --win"
